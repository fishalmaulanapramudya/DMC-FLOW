NODE_ENV=development
PORT=8000
# Local phone testing: NODE_ENV=development allows loopback/private LAN HTTP origins only.
# For production, list exact trusted frontend origins, comma-separated; never use *.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://fishal:URL_ENCODED_PASSWORD@127.0.0.1:5432/lms_fishal
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
DATABASE_SSL=false
