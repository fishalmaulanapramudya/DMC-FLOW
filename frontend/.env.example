# Recommended for laptop + phone on the same Wi-Fi: keep /api and use the Vite proxy.
# Open the frontend from the phone via http://<COMPUTER-LAN-IP>:5173, NOT localhost.
# For Cloudflare/prod on one hostname, also use /api behind a reverse proxy.
# For separate public hostnames only, set the full API URL and list the exact frontend origin in backend/FRONTEND_URL.
VITE_API_BASE_URL=/api
